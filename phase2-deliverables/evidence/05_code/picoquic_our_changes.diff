+                    pvseed_apply_spec_reset_on_new_peer_addr(cnx, path_x,
+                        (struct sockaddr*)&path_x->first_tuple->peer_addr,
+                        (struct sockaddr*)&tuple->peer_addr, current_time);
+
                     previous_tuple->next_tuple = tuple->next_tuple;
                     tuple->next_tuple = path_x->first_tuple;
                     path_x->first_tuple = tuple;
