+/* --- PV-Seed Task 1 (capstone-research, Phase 1): RFC 9000 9.4 paragraph 1 ---
+ *
+ * pvseed_apply_spec_reset_on_new_peer_addr() (further below, next to
+ * picoquic_decode_path_response_frame()) implements paragraph 2 of RFC 9000
+ * 9.4 -- resetting congestion control and the RTT estimator to their initial
+ * values on a confirmed peer migration. It does NOT by itself satisfy
+ * paragraph 1:
+ *
+ *   "The capacity available on the new path might not be the same as the
+ *    old path. Packets sent on the old path MUST NOT contribute to
+ *    congestion control or RTT estimation for the new path."
+ *
+ * Measured consequence (qlog, step-down scenario): immediately after the
+ * paragraph-2 reset fires, an ACK for a packet that was in flight on the
+ * OLD path arrives and is processed as if it were a new-path sample --
+ * because rtt_is_initialized was just cleared, picoquic_update_path_rtt()
+ * takes its "is_first" branch and seeds smoothed_rtt directly from that
+ * stale, wrong-path sample (e.g. a ~20 ms old-path sample re-seeding the
+ * estimator for a path whose true RTT is ~60 ms), while the same packet's
+ * bytes are simultaneously credited to the congestion window. Slow start
+ * then paces at 3x the new path's true RTT and overshoots its BDP.
+ *
+ * The fix: pvseed_packet_predates_reset() below is a predicate that callers
+ * use to recognize "this acked packet was sent on the old path, before the
+ * reset" so they can skip its RTT/CC contribution -- without touching
+ * anything else about how the ACK is processed (retransmit-queue removal,
+ * flow control, MTU discovery, etc. are unaffected; only the RTT-estimator
+ * and congestion-control inputs are suppressed for these packets). It is
+ * used at both places in this file where an acked packet's send time
+ * currently feeds RTT/CC: picoquic_record_ack_packet_data() (the sole
+ * feeder of the packet_data aggregate consumed by picoquic_update_path_rtt(),
+ * the bandwidth estimator, and the CC "acknowledgement" notification in
+ * process_decoded_packet_data()), and the spurious-retransmission CC
+ * notification in picoquic_check_spurious_retransmission().
+ *
+ * Gated entirely by whether a reset has actually recorded a timestamp on
+ * this path (path_x->pvseed_reset_time_is_set), which itself only happens
+ * inside pvseed_apply_spec_reset_on_new_peer_addr() when PVSEED_SPEC_RESET=1.
+ * With the flag OFF (or before any migration), pvseed_reset_time_is_set is
+ * always 0 (zeroed by the memset() in picoquic_create_path()), so this
+ * predicate is always false and every call site below is a single cheap
+ * bitfield test that changes no behaviour -- the control arm remains
+ * byte-identical to stock picoquic.
+ */
+static int pvseed_packet_predates_reset(const picoquic_path_t* send_path, uint64_t packet_send_time)
+{
+    return send_path != NULL && send_path->pvseed_reset_time_is_set &&
+        packet_send_time < send_path->pvseed_reset_time;
+}
