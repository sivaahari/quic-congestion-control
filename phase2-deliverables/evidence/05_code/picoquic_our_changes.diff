+/* --- PV-Seed Task 2 (capstone-research, Phase 1): RFC 9000 9.4 reset ---
+ *
+ * Stock picoquic never performs the congestion-control/RTT reset that RFC
+ * 9000 Section 9.4 requires on confirmed peer migration: every congestion
+ * algorithm implements a handler for picoquic_congestion_notification_reset
+ * (newreno.c, cubic.c, bbr.c, bbr1.c, c4.c, fastcc.c, prague.c) but nothing
+ * in the codebase ever dispatches that notification -- it is a dead hook.
+ * Likewise the RTT estimator (smoothed_rtt/rtt_variant/rtt_min) simply
+ * carries over from the old path to the new one across a migration. This
+ * function adds the missing reset, called from the two places where an
+ * endpoint confirms (or, in the NAT-rebinding heuristic case, assumes)
+ * ownership of what is about to become a path's new PRIMARY peer address:
+ *
+ *   1. picoquic_decode_path_response_frame(), below: a non-primary tuple's
+ *      challenge/response round trip has just completed and it is about to
+ *      be promoted to path_x->first_tuple.
+ *   2. picoquic_find_incoming_path() in paths.c: the multipath NAT-rebinding
+ *      heuristic, which promotes a brand-new tuple and marks it verified
+ *      immediately, without waiting for a round trip.
+ *
+ * Both call sites hand this function the OLD (pre-promotion) and NEW peer
+ * addresses of the SAME path object. Applying one symmetric check at both
+ * call sites -- rather than special-casing "server-only" -- naturally
+ * produces the right scoping without asking this code to know which role
+ * (client or server) it is running as: whichever endpoint's path just had
+ * its PEER address change is the one whose sender-side state needs
+ * resetting. In the PV-Seed test harness (client migrates its own local
+ * address; the server's address never changes) that means: a no-op on the
+ * client (its peer -- the server -- did not move) and a real reset on the
+ * server (its peer -- the client -- did move), which is exactly the
+ * behaviour under study.
+ *
+ * Gated behind the PVSEED_SPEC_RESET=1 environment variable, default OFF.
+ * With it unset, this function is one cached getenv() check plus one
+ * pointer/family comparison -- no state is touched, so the control arm
+ * (PVSEED_SPEC_RESET=0) is byte-identical to stock picoquic. Does not touch
+ * the seed_cwin/BDP path (picoquic_validate_bdp_seed / timing.c), which is
+ * separate, already-live machinery reserved for a later phase.
+ */
+void pvseed_apply_spec_reset_on_new_peer_addr(picoquic_cnx_t* cnx, picoquic_path_t* path_x,
+    const struct sockaddr* old_peer_addr, const struct sockaddr* new_peer_addr, uint64_t current_time)
+{
+    static int checked = 0;
+    static int enabled = 0;
+
+    if (!checked) {
+        const char* s = getenv("PVSEED_SPEC_RESET");
+        enabled = (s != NULL && strcmp(s, "1") == 0);
+        checked = 1;
+    }
+    if (!enabled) {
+        return;
+    }
+    if (old_peer_addr == NULL || new_peer_addr == NULL ||
+        old_peer_addr->sa_family == 0 || new_peer_addr->sa_family == 0) {
+        return;
+    }
+    /* RFC 9000 9.4: exempt changes limited to the port number (e.g. NAT
+     * rebinding); only an IP-address change (with or without a port change)
+     * triggers the reset. */
+    if (picoquic_compare_ip_addr(old_peer_addr, new_peer_addr) == 0) {
+        return;
+    }
+
+    /* (i) Congestion controller: dispatch the existing (previously dead)
+     * "reset" notification through the normal alg_notify plumbing, so each
+     * algorithm's own bookkeeping (slow-start state, ssthresh, etc., not
+     * just cwin) is consistently reinitialized. */
+    {
+        picoquic_per_ack_state_t ack_state;
+        memset(&ack_state, 0, sizeof(picoquic_per_ack_state_t));
+        cnx->congestion_alg->alg_notify(cnx, path_x, picoquic_congestion_notification_reset,
+            &ack_state, current_time);
+    }
+    /* Defense in depth: every algorithm's own reset handler is supposed to
+     * set path_x->cwin from its post-reset state (e.g. newreno.c's
+     * picoquic_newreno_reset() does `path_x->cwin = nr_state->nrss.cwin;`),
+     * but -- per the FACT above -- that call chain has never had a live
+     * caller and so has zero real-world test coverage. Assert the RFC
+     * 9002-mandated initial value explicitly, so a latent bug in any one
+     * algorithm's reset handler cannot silently leave the old, larger cwin
+     * in place.
+     */
+    path_x->cwin = PICOQUIC_CWIN_INITIAL;
+
+    /* (ii) RTT estimator: back to the same initial values used when a path
+     * is first created (see picoquic_create_path() in quicctx.c), per
+     * RFC 9002 Appendix A.3 (initialization) / B.3 (reset on PTO / new
+     * path). rtt_max intentionally left untouched -- it is a pure
+     * monitoring statistic, not part of the loss-recovery/CC state RFC 9002
+     * mandates resetting. */
+    path_x->rtt_is_initialized = 0;
+    path_x->smoothed_rtt = PICOQUIC_INITIAL_RTT;
+    path_x->rtt_variant = 0;
+    path_x->rtt_min = 0;
+
+    /* (iii) RFC 9000 9.4 paragraph 1: record this instant so that
+     * pvseed_packet_predates_reset() (top of this file) can recognize and
+     * exclude any ACK for a packet sent on the old path -- before this
+     * reset -- from contributing to the new path's RTT estimation or
+     * congestion control. Without this, an ACK for an old-path packet
+     * arriving shortly after this reset would otherwise be treated as the
+     * new path's first-ever RTT sample (because rtt_is_initialized was just
+     * cleared above) and would inflate cwin, re-seeding both the RTT
+     * estimator and the congestion window from a stale, wrong-path
+     * measurement. See the PV-Seed Task 1 banner comment near the top of
+     * this file for the full rationale and measured evidence. */
+    path_x->pvseed_reset_time = current_time;
+    path_x->pvseed_reset_time_is_set = 1;
+
+    picoquic_log_app_message(cnx, "PV-Seed spec_reset: path %" PRIu64 " congestion/RTT reset on peer address change (cwin -> %" PRIu64 ")",
+        path_x->unique_path_id, path_x->cwin);
+}
